target/
dist/
pages/
# Audio, stems and model files are never committed: songs are copyrighted,
# and the model weights have no stated licence.
audio/
stems/
third_party/
*.mp3
*.wav
*.safetensors
*.ckpt
**/tests/snapshots/**/*.diff.png
**/tests/snapshots/**/*.new.png
**/tests/snapshots/**/*.old.png
# The project's Claude Code rules, agents, skills and settings are tracked
# (docs/decisions/0001-harness-in-the-repo.md), even where a global gitignore
# ignores .claude/; worktrees and personal settings are not.
!/.claude/
/.claude/worktrees/
**/.claude/settings.local.json
