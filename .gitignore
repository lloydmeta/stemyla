target/
# cargo-mutants writes mutants.out at the root when a person runs it by hand.
# xtask review mutants writes into the run folder under target/review/.
/mutants.out*/
/app/dist/
/pages/
# Audio, stems and model files are never committed: songs are copyrighted,
# and the model weights have no stated licence.
# The folders are anchored at the root, so a source folder of the same name
# deeper in the tree is not ignored.  xtask/src/rules.rs checks the index too
# (ASSET-1).
/audio/
/stems/
/third_party/
*.mp3
*.wav
*.flac
*.ogg
*.opus
*.m4a
*.aac
*.aif
*.aiff
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.npy
*.npz
*.gguf
**/tests/snapshots/**/*.diff.png
**/tests/snapshots/**/*.new.png
**/tests/snapshots/**/*.old.png
# The project's Claude Code rules, agents, skills and settings are tracked
# (docs/decisions/0001-harness-in-the-repo.md), even where a global gitignore
# ignores .claude/; worktrees and personal settings are not.
!/.claude/
/.claude/worktrees/
**/.claude/settings.local.json
# Cargo.lock is tracked, even where a global gitignore ignores it.
# cargo-mutants copies the tree with the ignore rules.  Without the lock
# file, the copy builds with the newest versions, and can fail
# (no_tracked_file_is_ignored).
!/Cargo.lock
